{
  "name": "demo-video",
  "private": true,
  "type": "module",
  "description": "Demo project build folder. `npm install` also copies the shared engine in (engine/sync.mjs).",
  "scripts": {
    "postinstall": "node ../../../../engine/sync.mjs .",
    "sync": "node ../../../../engine/sync.mjs .",
    "check": "node tools/checkquotes.mjs",
